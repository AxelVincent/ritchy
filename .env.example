# =============================================================================
# Root Environment Variables
# Shared database and infrastructure connections used by all services.
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Primary Database)
# -----------------------------------------------------------------------------
PGHOST='localhost'
PGUSER='postgres'
PGPASSWORD='postgres'
PGDATABASE='ritchy'
PGPORT='5432'

# -----------------------------------------------------------------------------
# PostgreSQL (Vector Database - separate instance for embeddings)
# -----------------------------------------------------------------------------
PGVECTORHOST='localhost'
PGVECTORUSER='postgres'
PGVECTORPASSWORD='postgres'
PGVECTORDATABASE='ritchy'
PGVECTORPORT='5433'

# -----------------------------------------------------------------------------
# Redis (Cache, BullMQ job queue, pub/sub)
# -----------------------------------------------------------------------------
REDISHOST='localhost'
REDISPORT='6379'
REDISUSER='ritchy'
REDISPASSWORD='password'

# -----------------------------------------------------------------------------
# Qdrant (Vector Database for semantic search)
# -----------------------------------------------------------------------------
QDRANT_API_KEY='your-qdrant-api-key'
QDRANT_URL='http://localhost:6333'
QDRANT_COLLECTION_NAME='ritchy'
