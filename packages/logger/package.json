{
  "name": "@ritchy/logger",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/**"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "biome format .",
    "check": "biome check .",
    "format:fix": "biome format --write ./src",
    "check:fix": "biome check --apply ./src"
  },
  "dependencies": {
    "pino": "9.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "tsup": "8.3.5"
  }
}
