{
  "name": "@ritchy/logger",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/**", "src/**"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "biome format .",
    "check": "biome check .",
    "format:fix": "biome format --write ./src",
    "check:fix": "biome check --apply ./src"
  },
  "dependencies": {
    "dotenv": "18.0.7",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "pino-loki": "3.0.0",
    "pino-pretty": "13.0.0",
    "tsup": "8.3.5"
  }
}
