{
  "name": "@ritchy/types",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "files": ["dist/**", "src/**"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "biome format .",
    "check": "biome check .",
    "format:fix": "biome format --write ./src",
    "check:fix": "biome check --apply ./src",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "tsup": "8.4.0"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "zod": "3.24.2"
  }
}
