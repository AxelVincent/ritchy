{
  "name": "@ritchy/types",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/**"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "format": "biome format .",
    "check": "biome check .",
    "format:fix": "biome format --write ./src",
    "check:fix": "biome check --apply ./src"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "tsup": "8.3.5",
    "zod": "3.23.8"
  },
  "dependencies": {
    "lucide-react": "0.460.0"
  }
}
