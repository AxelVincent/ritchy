{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "apps/front": {
      "entry": ["src/main.tsx"],
      "project": "**/*.{ts,tsx}",
      "ignoreDependencies": [
        "@radix-ui/react-hover-card",
        "react-hook-form",
        "@radix-ui/react-progress",
        "@radix-ui/react-slider",
        "next-themes"
      ]
    },
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": "**/*.{ts,tsx}"
    },
    "packages/logger": {
      "entry": ["src/index.ts"],
      "project": "**/*.{ts,tsx}",
      "ignoreDependencies": ["pino-pretty"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": "**/*.{ts,tsx}"
    }
  },
  "ignore": [
    "**/dist/**",
    "**/build/**",
    "**/components/ui/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
