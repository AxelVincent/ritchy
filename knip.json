{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "apps/*": {
      "entry": ["src/index.ts", "src/main.tsx"],
      "project": "**/*.{ts,tsx}",
      "ignoreDependencies": [
        "@radix-ui/react-collapsible",
        "@radix-ui/react-hover-card",
        "react-hook-form"
      ]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": "**/*.{ts,tsx}"
    }
  },
  "ignore": [
    "**/dist/**",
    "**/build/**",
    "**/components/ui/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "**/google-maps.types.ts"
  ],
  "ignoreBinaries": ["db:migrate"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
