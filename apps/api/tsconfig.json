{
  "compilerOptions": {
    "target": "ES2018",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "strict": true,
    "incremental": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
