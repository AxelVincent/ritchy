{
  "compilerOptions": {
    "target": "ES2018",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "module": "ESNext",
    "strict": true,
    "incremental": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "baseUrl": "../../",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@/*": ["./src/*"],
      "@ritchy/logger": ["../../packages/logger/src"]
    },
    "composite": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
