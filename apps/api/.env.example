# API configuration
NODE_ENV='development'
PORT=3030
CORS_ORIGIN='*'
FRONTEND_BASE_URL='http://localhost:5173'
BASE_URL="http://localhost:3030"
SESSION_SECRET="SESSION_SECRET"

# Logging Configuration
# Options: trace, debug, info, warn, error, fatal
# Default: info (debug in development)
LOG_LEVEL='debug'

# Metrics Configuration
# Optional: If set, /metrics endpoint will require HTTP Basic Auth
METRICS_USERNAME='metrics'
METRICS_PASSWORD='secure_password_change_me'

# Database
PGHOST='localhost'
PGUSER='postgres'
PGPASSWORD='postgres'
PGDATABASE='ritchy'
PGPORT='5432'

# Database Vector
PGVECTORHOST='localhost'
PGVECTORUSER='postgres'
PGVECTORPASSWORD='postgres'
PGVECTORDATABASE='ritchy'
PGVECTORPORT='5433'

# Redis Authentication
REDISHOST='localhost'
REDISPORT='6379'
REDISUSER='ritchy'
REDISPASSWORD='password'

# RabbitMQ
RABBITMQ_USER='ritchy'
RABBITMQ_HOST='localhost'
RABBITMQ_PASSWORD='password'
RABBITMQ_VHOST='/'
RABBITMQ_PORT='5672'
RABBITMQ_MANAGEMENT_PORT='15672'

# APIs
## Google
GOOGLE_PLACES_API_KEY='example'
GOOGLE_GEOCODING_API_KEY='example'
GOOGLE_CALENDAR_API_KEY='example'
GOOGLE_PLACES_REFERRER='dev.api.ritchy.io'

GOOGLE_CLIENT_ID='example'
GOOGLE_CLIENT_SECRET='example'
GOOGLE_REDIRECT_URI='http://localhost:5473'

## Clerk
CLERK_PUBLISHABLE_KEY='example'
CLERK_SECRET_KEY='example'
CLERK_WEBHOOK_SECRET='example'

## Sentry
SENTRY_AUTH_TOKEN='example'

## Slack
SLACK_BOT_TOKEN='example'

## Stripe
### API Keys
STRIPE_SECRET_KEY='example'
STRIPE_PUBLIC_KEY='example'
STRIPE_WEBHOOK_SECRET='example'

### Price IDs
#### Monthly
STRIPE_PRO_MONTHLY_PRICE_ID='example'
STRIPE_ESSENTIALS_MONTHLY_PRICE_ID='example'

#### Quarterly
STRIPE_PRO_QUARTERLY_PRICE_ID='example'
STRIPE_ESSENTIALS_QUARTERLY_PRICE_ID='example'

#### Yearly
STRIPE_PRO_YEARLY_PRICE_ID='example'
STRIPE_ESSENTIALS_YEARLY_PRICE_ID='example'

### Product IDs
STRIPE_PRO_PRODUCT_ID='example'
STRIPE_ESSENTIALS_PRODUCT_ID='example'

### Rust HTML Service
# URL for the Rust HTML processing microservice
RUST_HTML_SERVICE_URL='http://localhost:3001'
# API key for authenticating with the Rust HTML service
RUST_HTML_SERVICE_API_KEY='your-secret-api-key-here'
# Timeout for Rust service requests in milliseconds
RUST_HTML_SERVICE_TIMEOUT_MS=30000
# Enable Rust HTML service (set to 'true' to use Rust instead of Node.js processing)
USE_RUST_HTML_SERVICE='true'

### BullMQ
SCRAPER_CONCURRENCY=10
BRIGHTDATA_CONCURRENCY=10
ENRICHMENT_UNIT_CONCURRENCY=10
ENRICHMENT_COMPANY_CONCURRENCY=5
ENRICHMENT_CONTACT_CONCURRENCY=10
SCRAPER_BATCH_EXIT_COUNT=1
ENRICHMENT_COMPANY_BATCH_EXIT_COUNT=1