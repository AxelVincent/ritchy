# =============================================================================
# API Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV='development'
PORT=3030
CORS_ORIGIN='*'
FRONTEND_BASE_URL='http://localhost:5173'
BASE_URL='http://localhost:3030'
SESSION_SECRET='your-session-secret'

# Logging (options: trace, debug, info, warn, error, fatal)
LOG_LEVEL='debug'

# -----------------------------------------------------------------------------
# Database (can override root .env values)
# -----------------------------------------------------------------------------
PGHOST='localhost'
PGUSER='postgres'
PGPASSWORD='postgres'
PGDATABASE='ritchy'
PGPORT='5432'

# Vector Database
PGVECTORHOST='localhost'
PGVECTORUSER='postgres'
PGVECTORPASSWORD='postgres'
PGVECTORDATABASE='ritchy'
PGVECTORPORT='5433'

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDISHOST='localhost'
REDISPORT='6379'
REDISUSER='ritchy'
REDISPASSWORD='password'

# -----------------------------------------------------------------------------
# Authentication - Clerk (https://dashboard.clerk.com)
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY='pk_test_...'
CLERK_SECRET_KEY='sk_test_...'
CLERK_WEBHOOK_SECRET='whsec_...'

# -----------------------------------------------------------------------------
# Payments - Stripe (https://dashboard.stripe.com)
# -----------------------------------------------------------------------------

## API Keys
STRIPE_SECRET_KEY='sk_test_...'
STRIPE_PUBLIC_KEY='pk_test_...'
STRIPE_WEBHOOK_SECRET='whsec_...'

## Product IDs
STRIPE_STARTER_PRODUCT_ID='prod_...'
STRIPE_GROWTH_PRODUCT_ID='prod_...'
STRIPE_ESSENTIALS_PRODUCT_ID='prod_...'
STRIPE_PRO_PRODUCT_ID='prod_...'
STRIPE_ENTERPRISE_PRODUCT_ID='prod_...'

## Price IDs - Monthly
STRIPE_STARTER_MONTHLY_PRICE_ID='price_...'
STRIPE_GROWTH_MONTHLY_PRICE_ID='price_...'
STRIPE_ESSENTIALS_MONTHLY_PRICE_ID='price_...'
STRIPE_PRO_MONTHLY_PRICE_ID='price_...'
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID='price_...'

## Price IDs - Quarterly
STRIPE_STARTER_QUARTERLY_PRICE_ID='price_...'
STRIPE_GROWTH_QUARTERLY_PRICE_ID='price_...'
STRIPE_ESSENTIALS_QUARTERLY_PRICE_ID='price_...'
STRIPE_PRO_QUARTERLY_PRICE_ID='price_...'
STRIPE_ENTERPRISE_QUARTERLY_PRICE_ID='price_...'

## Price IDs - Yearly
STRIPE_STARTER_YEARLY_PRICE_ID='price_...'
STRIPE_GROWTH_YEARLY_PRICE_ID='price_...'
STRIPE_ESSENTIALS_YEARLY_PRICE_ID='price_...'
STRIPE_PRO_YEARLY_PRICE_ID='price_...'
STRIPE_ENTERPRISE_YEARLY_PRICE_ID='price_...'

# -----------------------------------------------------------------------------
# Google APIs (https://console.cloud.google.com)
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY='AIza...'
GOOGLE_GEOCODING_API_KEY='AIza...'
GOOGLE_CALENDAR_API_KEY='AIza...'
GOOGLE_PLACES_REFERRER='dev.api.ritchy.io'

GOOGLE_CLIENT_ID='...apps.googleusercontent.com'
GOOGLE_CLIENT_SECRET='GOCSPX-...'
GOOGLE_REDIRECT_URI='http://localhost:5173'

# -----------------------------------------------------------------------------
# Enrichment Data Providers
# -----------------------------------------------------------------------------

## IcyPeas - Email finding (https://icypeas.com)
ICYPEAS_API_KEY='your-icypeas-api-key'
ICYPEAS_EMAIL='your-account@email.com'

## Pappers - French company registry (https://www.pappers.fr/api)
PAPPERS_API_KEY='your-pappers-api-key'

## Forager - People & company data
FORAGER_API_KEY='your-forager-api-key'
FORAGER_ACCOUNT_ID='your-forager-account-id'

## Brightdata - Web scraping (https://brightdata.com)
BRIGHTDATA_API_KEY='your-brightdata-api-key'

## Million Verifier - Email verification (https://www.millionverifier.com)
MILLION_VERIFIER_API_KEY='your-million-verifier-api-key'

## ContactOut - People search (https://contactout.com)
CONTACTOUT_API_KEY='your-contactout-api-key'

## Firecrawl - Website scraping (https://firecrawl.dev)
FIRECRAWL_API_KEY='your-firecrawl-api-key'

## WHOIS - Domain data
WHOIS_API_KEY='your-whois-api-key'

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
OPENAI_API_KEY='sk-...'
ANTHROPIC_API_KEY='sk-ant-...'
MISTRAL_API_KEY='your-mistral-api-key'
GOOGLE_AI_API_KEY='AIza...'

## LangSmith - LLM tracing (https://smith.langchain.com)
LANGSMITH_API_KEY='lsv2_...'
LANGSMITH_TRACING=false

# -----------------------------------------------------------------------------
# Vector Database - Qdrant
# -----------------------------------------------------------------------------
QDRANT_API_KEY='your-qdrant-api-key'
QDRANT_URL='http://localhost:6333'
QDRANT_COLLECTION_NAME='ritchy'

# -----------------------------------------------------------------------------
# Rust HTML Service (microservice for HTML processing)
# -----------------------------------------------------------------------------
RUST_HTML_SERVICE_URL='http://localhost:3001'
RUST_HTML_SERVICE_API_KEY='your-secret-api-key-here'
RUST_HTML_SERVICE_TIMEOUT_MS=30000
USE_RUST_HTML_SERVICE='true'

# -----------------------------------------------------------------------------
# BullMQ - Job Queue Concurrency
# -----------------------------------------------------------------------------
SCRAPER_CONCURRENCY=10
BRIGHTDATA_CONCURRENCY=10
ENRICHMENT_UNIT_CONCURRENCY=10
ENRICHMENT_COMPANY_CONCURRENCY=5
ENRICHMENT_CONTACT_CONCURRENCY=10
SCRAPER_BATCH_EXIT_COUNT=1
ENRICHMENT_COMPANY_BATCH_EXIT_COUNT=1

# -----------------------------------------------------------------------------
# Monitoring & Admin
# -----------------------------------------------------------------------------

## Metrics endpoint Basic Auth
METRICS_USERNAME='metrics'
METRICS_PASSWORD='secure_password_change_me'

## QueueDash Basic Auth
QUEUE_DASH_USERNAME='admin'
QUEUE_DASH_PASSWORD='secure_password_change_me'

## Sentry - Error tracking (https://sentry.io)
SENTRY_AUTH_TOKEN='sntrys_...'

## Slack - Notifications
SLACK_BOT_TOKEN='xoxb-...'
