  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build:watch": "tsup --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "format": "biome format",
    "format:fix": "biome format --write .",
    "check": "biome check",
    "check:fix": "biome check --write ./src",
    "build": "tsup",
    "build:clean": "rm -rf dist && pnpm build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:integration:db:up": "docker-compose -f docker-compose.test.yml up -d",
    "test:integration:db:down": "docker-compose -f docker-compose.test.yml down",
    "script:data-migration": "tsx src/scripts/data_migration.ts",
    "webhook:stripe:dev": "stripe listen --forward-to localhost:3030/webhook/stripe",
    "webhook:clerk:dev": "svix listen http://localhost:3030/webhook/clerk/"
  },
